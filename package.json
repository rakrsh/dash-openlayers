{
  "name": "dash-openlayers",
  "version": "0.0.2",
  "private": true,
  "main": "dash_openlayers/dash_openlayers.umd.js",
  "module": "dash_openlayers/dash_openlayers.esm.js",
  "scripts": {
    "build": "rollup -c && uv run --no-default-groups --group build python scripts/generate_components.py && uv run --no-default-groups --group build python scripts/generate_api_docs.py",
    "build:js": "rollup -c",
    "build:components": "uv run --no-default-groups --group build python scripts/generate_components.py",
    "docs:api": "uv run --no-default-groups --group build python scripts/generate_api_docs.py",
    "lint": "eslint src",
    "format": "prettier --write src *.js *.json",
    "test": "jest --runInBand --coverage",
    "check-ai-invariants": "node scripts/check-ai-invariants.js",
    "mcp-inspect-metadata": "node mcp/dash-build-validator.js",
    "mcp-validate-spatial": "node mcp/gis-data-inspector.js"
  },
  "dependencies": {
    "@turf/boolean-valid": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "ol": "^9.0.0",
    "proj4": "^2.8.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-docgen": "5.4.3",
    "react-dom": "^19.0.0",
    "topojson-server": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/plugin-transform-react-jsx": "^7.22.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@plotly/dash-component-plugins": "^1.2.3",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-postcss": "^4.0.0"
  }
}
